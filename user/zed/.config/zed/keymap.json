    "context": "vim_mode == insert",
    "unbind": {
      "ctrl-x ctrl-l": "editor::ToggleCodeActions",
    },
  },
  {
    "context": "vim_mode == visual",
    "unbind": {
      "g ctrl-x": [
        "vim::Decrement",
        {
          "step": true,
        },
      ],
    },
  },
  {
    "context": "vim_mode == insert",
    "unbind": {
      "ctrl-x ctrl-e": "vim::LineDown",
    },
  },
  {
    "context": "vim_mode == insert",
    "unbind": {
      "ctrl-x ctrl-y": "vim::LineUp",
    },
  },
  {
    "context": "VimControl && !menu",
    "unbind": {
      "ctrl-t": "pane::GoToOlderTag"
    }
  },
  {
    "context": "vim_mode == insert",
    "unbind": {
      "ctrl-t": "vim::Indent"
    }
  },
  {
    "context": "vim_mode == literal",
    "unbind": {
      "ctrl-t": [
        "vim::Literal",
        [
          "ctrl-t",
          "\u0014"
        ]
      ]
    }
  },
  {
    "context": "ProjectPanel && not_editing",
    "unbind": {
      "z z": "project_panel::ScrollCursorCenter"
    }
  },
  {
    "context": "ProjectPanel && not_editing",
    "bindings": {
      "z z": "project_panel::CollapseAllEntries"
    }
  },
  {
    "context": "ProjectPanel",
    "unbind": {
      "ctrl-left": "project_panel::CollapseAllEntries"
    }
  }
]
