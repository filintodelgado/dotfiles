// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "cli_default_open_behavior": "existing_window",
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "left",
    "tree_view": true
  },
  "buffer_line_height": "comfortable",
  "title_bar": {
    "show_menus": false,
    "show_sign_in": false,
    "show_user_menu": true,
    "show_branch_icon": false
  },
  "project_panel": {
    "dock": "left",
    "button": true
  },
  "toolbar": {
    "code_actions": false,
    "agent_review": true,
    "selections_menu": true,
    "quick_actions": true,
    "breadcrumbs": true
  },
  "diagnostics": {
    "inline": {
      "enabled": true
    }
  },
  "disable_ai": true,
  "vim": {
    "toggle_relative_line_numbers": true,
  },
  "ui_font_family": "JetBrainsMono Nerd Font",
  "languages": {
    "Rust": {
      "hard_tabs": false,
    },
  },
  "buffer_font_weight": 500.0,
  "terminal": {
    "font_weight": 500.0,
    "font_size": 13.0,
  },
  "agent": {
    "dock": "right",
    "enabled": false,
    "button": false,
    "favorite_models": [],
    "model_parameters": [],
  },
  "relative_line_numbers": "enabled",
  "gutter": {
    "line_numbers": true,
  },
  "cursor_blink": true,
  "use_system_path_prompts": false,
  "buffer_font_fallbacks": ["monospace"],
  "buffer_font_family": "JetBrainsMono Nerd Font Mono",
  "show_whitespaces": "all",
  "wrap_guides": [80, 100],
  "base_keymap": "VSCode",
  "vim_mode": true,
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Zed (Default)",
  },
  "ui_font_size": 16.0,
  "buffer_font_size": 14.0,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Catppuccin Mocha (blue)",
  },
}
